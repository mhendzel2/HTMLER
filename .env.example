
###############################################
# Environment Template (NO REAL SECRETS)      #
# Copy this file to ".env" and fill values.  #
###############################################

# Core App / Auth
NEXTAUTH_URL=
NEXTAUTH_SECRET=
DATABASE_URL=
NODE_ENV=development

# Unusual Whales API
UNUSUAL_WHALES_API_KEY=
NEXT_PUBLIC_UNUSUAL_WHALES_API_KEY=
UNUSUAL_WHALES_API_BASE_URL=https://api.unusualwhales.com

# AI / ML Providers
HUGGINGFACE_API_TOKEN=
GEMINI_API_KEY=

# Market / External Data APIs
OPENFDA_API_KEY=
FRED_API_KEY=
ALPHA_VANTAGE_API_KEY=
MARKETAUX_API_KEY=

# Discord Bot (leave blank in repo)
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
ALERT_CHANNEL_ID=
ADMIN_ROLE_ID=

# Optional Flags / Misc
# NEXT_PUBLIC_FEATURE_FLAGS=

# Notes:
# 1. Do NOT commit your filled .env file.
# 2. If any secret was previously committed, rotate it immediately.
# 3. Public keys intended for client use must be prefixed with NEXT_PUBLIC_.
